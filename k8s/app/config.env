# 비밀이 아닌 고정값 (ConfigMap chamabosal-app-config). 비밀값과 서버마다 다른 값은 Secret chamabosal-app-env에 둔다 (README).
# 값을 바꾸면 ConfigMap 이름 해시가 바뀌어 Deployment가 새 값으로 다시 뜬다.
SPRING_PROFILES_ACTIVE=prod
# 마이그레이션 도구가 없어 출시 전까지 스키마를 자동 반영한다. 출시 시 지워 validate로 돌린다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
DB_URL=jdbc:mysql://mysql:3306/chamabosal?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
TOSS_MTLS_CERT_PATH=/app/toss/chamabosal.crt
TOSS_MTLS_KEY_PATH=/app/toss/chamabosal.key
# actuator를 관리 포트 8081로 분리한다. Service·HTTPRoute는 8080만 넘겨 앱 지표(/actuator/prometheus)가 Gateway로 나가지 않는다.
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
